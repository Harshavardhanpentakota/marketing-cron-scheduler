# ==============================================================================
# Marketing Cron Scheduler - Environment Configuration
# ==============================================================================

# Database URL (Default: SQLite local file)
DATABASE_URL=sqlite:///./scheduler.db

# ------------------------------------------------------------------------------
# WhatsApp Business Cloud API Configuration (Meta Graph API)
# Get credentials at: https://developers.facebook.com/apps/
# ------------------------------------------------------------------------------
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# Email SMTP Configuration
# Compatible with Gmail (App Password), SendGrid, Amazon SES, Mailgun, Resend, etc.
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=marketing@yourcompany.com
EMAIL_FROM_NAME="Marketing Team"

# ------------------------------------------------------------------------------
# Mock Dispatch Mode
# If True (or if credentials above are left empty), dispatches will be safely
# simulated in development, logging full previews to console and database without
# throwing network errors. Set to False when deploying to production with real credentials.
# ------------------------------------------------------------------------------
MOCK_DISPATCH=true
